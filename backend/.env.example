# MongoDB connection string (Atlas or local instance)
# Example format: mongodb+srv://<user>:<password>@<cluster-url>/<database>
MONGO_URL=

# Port the Express server listens on
PORT=5000

# Shared passcode required to register as doctor, nurse or pharmacist
PASSCODE=

# Secret used to sign JWTs (generate a long random string, e.g. `openssl rand -hex 48`)
JWT_SECRET=

# Frontend origin allowed to call this API with credentials (cookies)
CLIENT_URL=http://localhost:3000
